# Copy to .env and fill in. Loaded automatically via python-dotenv.

# --- Required ---
# Chat + research agents (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-...
# Embeddings (Cohere)
COHERE_API_KEY=...

# --- Optional: web research (Firecrawl search + scrape + crawl) ---
# Get a key at https://firecrawl.dev. Without it everything else still works;
# only the "Research the web" button returns 503.
FIRECRAWL_API_KEY=fc-...

# --- Optional: overrides ---
# NOTEBOOKLM_EMBEDDING_MODEL=embed-multilingual-v3.0
# NOTEBOOKLM_HOST=127.0.0.1
# NOTEBOOKLM_PORT=4040
# NOTEBOOKLM_RELOAD=0        # 1 to restart the server on file changes

# The chat model and the embedding provider are set in code, not here:
# see agents/chat.py, agents/research.py and core/store.py.
